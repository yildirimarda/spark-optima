{
  "$schema": "https://opencode.ai/config.json",

  "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
  "small_model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",

  "permission": {
    "*": "allow",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push*main*": "deny",
      "git push*master*": "deny",
      "terraform apply*": "deny",
      "terraform destroy*": "deny"
    },
    "edit": {
      "*": "allow",
      ".github/workflows/**": "deny"
    }
  },

  "mcp": {
    "graphify": {
      "type": "local",
      "command": ["/opt/graphify/bin/python", "-m", "graphify.serve", "graphify-out/graph.json"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "GRAPHIFY_QUERY_LOG_DISABLE": "1"
      }
    }
  },

  "provider": {
    "openrouter": {
      "options": {
        "timeout": 600000
      }
    }
  }
}
